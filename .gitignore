# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Production build
build/
dist/

# Environment files — NEVER commit secrets
.env
.env.*
!.env.example

# GCP service account keys and other credentials
*.json.key
gcp-key.json
service-account*.json

# Debug logs
*.log
auth-debug.log
debug_payment.log

# Deployment artefacts
deployment-logs/

# Scratch / temporary working files
scratch/
tmp/
temp/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code local/personal settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Test coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo

# PM2 logs
logs/

# Local deploy cache (md5 of package-lock.json, rewritten by deploy.sh on every
# install). Per-environment — not source. See deploy.sh's "Dependencies changed"
# block.
.npm-lock-hash

# One-off migration state snapshots (e.g. pre-cutover Razorpay plan IDs).
# These are recovery artefacts — kept on the operator's machine, not in git.
scripts/*-backup-*.json
