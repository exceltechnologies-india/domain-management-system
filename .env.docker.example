# Environment for the local Docker stack (docker-compose.yml).
#
#   cp .env.docker.example .env.docker
#
# ─── EVERY VALUE HERE IS FAKE, AND MOST OF THEM POINT NOWHERE ────────────────
# Several modules in this app throw at IMPORT time when their env var is absent
# (lib/auth-secret.ts, lib/razorpay-client.ts, lib/email/transporter.ts), so the
# container will not boot with them blank. That leaves two ways to satisfy them,
# and only one is safe:
#
#   WRONG — paste the real credentials in so "everything works". A local box
#           then holds production keys for ResellerClub and DirectAdmin, and a
#           stray test run registers a real domain or creates a real hosting
#           account. Both cost money and neither can be undone.
#
#   RIGHT — set them to syntactically valid values aimed at a host that cannot
#           exist. `.invalid` is reserved by RFC 2606 and never resolves, so the
#           module loads, the code path runs, and the network call fails.
#
# That is what the URLs below do. The app boots, the Engine API answers, and
# nothing can reach a real upstream even by accident. If you ever find yourself
# editing a `.invalid` host to make something work, stop — that is the guard
# doing its job, not a bug.
#
# NEVER copy real values from .env.local or Secret Manager into this file.

# ─── Local infrastructure (compose service names, not localhost) ─────────────
MONGODB_URI=mongodb://mongo:27017/dms
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Self-referencing URLs — the host port from docker-compose.yml ───────────
APP_URL=http://localhost:4310
NEXTAUTH_URL=http://localhost:4310

# ─── Secrets: local-only, not derived from anything real ────────────────────
# Regenerate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=local-dev-only-nextauth-secret-change-me-0000000000000000
JWT_SECRET=local-dev-only-jwt-secret-change-me-000000000000000000000000
CRON_SECRET=local-dev-only-cron-secret

# ─── Engine API — what ResellerOS authenticates with ────────────────────────
# Copy the read key into ResellerOS's DMS_ENGINE_READ_KEY. The other two are
# unset on purpose: no command route exists yet, and an unset key means every
# command request is refused rather than allowed.
ENGINE_READ_API_KEY=local-dev-engine-read-key-0000000000000000
BILLING_PROVISION_API_KEY=
# Shared with ResellerOS as DMS_SSO_SECRET. Signs the 60-second,
# single-use hand-off that logs a ResellerOS user in here. Separate from
# NEXTAUTH_SECRET/JWT_SECRET because it is shared with another app and is
# therefore the likeliest of the three to leak. Unset = SSO refused.
ENGINE_SSO_SECRET=local-dev-sso-shared-secret-0000000000000000
BILLING_COMMAND_API_KEY=

# ─── Upstreams that spend money — deliberately unreachable ──────────────────
RESELLERCLUB_API_URL=https://resellerclub.local.invalid
RESELLERCLUB_ID=000000
RESELLERCLUB_RESELLER_ID=000000
RESELLERCLUB_SECRET=local-dev-not-a-real-key
RESELLERCLUB_BALANCE_THRESHOLD=0

DIRECTADMIN_URL=https://directadmin.local.invalid:2222
DIRECTADMIN_ADMIN_USER=local-dev
DIRECTADMIN_API_KEY=local-dev-not-a-real-key
DIRECTADMIN_IP=127.0.0.1

RAZORPAY_KEY_ID=rzp_test_localdevonly
RAZORPAY_KEY_SECRET=local-dev-not-a-real-key

# ─── Email — a sink, so nothing is ever delivered to a real person ──────────
SMTP_HOST=smtp.local.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dev@local.invalid
SMTP_PASS=local-dev-not-a-real-password
FROM_EMAIL=dev@local.invalid
FROM_NAME=DMS Local

# ─── Required for GST tax-type calculation (CGST+SGST vs IGST) ──────────────
# The state our GSTIN is registered in. The invoice engine refuses without it.
COMPANY_STATE=Delhi

# ─── reCAPTCHA blank on purpose ─────────────────────────────────────────────
# The real site key is domain-locked to app.anutech.in, so on localhost the
# widget errors and leaves the sign-in button disabled. Empty makes the client
# skip it and the server verifier short-circuit — the same switch
# scripts/run-local.sh flips, here scoped to the container instead of a file
# the deploy script reads.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
