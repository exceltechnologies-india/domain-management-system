# Build artifacts
node_modules
.next
out
build

# Version control
.git
.github
.gitignore

# Logs (ephemeral on Cloud Run – never copy into image)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
auth-debug.log
auth-debug.log.1

# Secrets & credentials (must never be in the image)
.env
.env.local
.env.production
.env*.local
# The local Docker stack's environment. Supplied at RUNTIME by compose's
# `env_file:`, so it must not be copied into the image — an env file baked into
# a layer outlives the container and survives being deleted from disk.
.env.docker
gcp-key.json

# Dev tooling
.vscode
.idea
*.swp

# Tests & scripts (not needed at runtime)
tests/
scripts/
coverage/

# Documentation
README.md
PROJECT_STRUCTURE.md
API.md
CLOUD_SCHEDULER.md
DA-Integration.md
SETUP.md

# Deployment / VPS tooling (not applicable in Cloud Run)
deploy.sh
view-logs.sh
deployment-logs

# Docker build files (no need to copy into themselves)
.dockerignore
Dockerfile
