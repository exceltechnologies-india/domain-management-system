# Environment variables consumed by the app. Copy to `.env.local` and fill
# in real values. Production deploys read from Secret Manager via Cloud Run
# — this file is for local dev + onboarding only.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
SUPPORT_EMAIL=
ADMIN_EMAIL=
ALLOWED_ORIGINS=

# ─── Database / cache ───────────────────────────────────────────────────────
MONGODB_URI=
REDIS_HOST=
REDIS_PORT=
FIELD_ENCRYPTION_KEY=

# ─── Auth (NextAuth + session) ──────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Razorpay (payments) ────────────────────────────────────────────────────
# Active Razorpay keys (what the app uses right now).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Both key sets for `scripts/switch-razorpay-mode.sh <test|live>` (one-command
# mode flip: swaps the active keys above + Secret Manager + full redeploy).
# Populate both once; copy your current live keys into the RAZORPAY_LIVE_* slots.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ─── ResellerClub (domain registrar) ────────────────────────────────────────
RESELLERCLUB_API_URL=
RESELLERCLUB_ID=
RESELLERCLUB_RESELLER_ID=
RESELLERCLUB_SECRET=
RESELLERCLUB_BALANCE_THRESHOLD=

# ─── DirectAdmin (hosting backend) ──────────────────────────────────────────
# DIRECTADMIN_IP: the public IP the DA panel uses for outbound webhook/origin
# checks. Cloud Run egress IP must be in DA's allow list (CSF + BFM + admin
# login key) — see memory/project_da_whitelist_layers.md.
# DA_DEFAULT_PACKAGE: fallback DA package name if the cart item didn't carry
# one (used by lib/services/payment/provisioner-hosting.ts).
DIRECTADMIN_URL=
DIRECTADMIN_ADMIN_USER=
DIRECTADMIN_API_KEY=
DIRECTADMIN_IP=
DA_DEFAULT_PACKAGE=

# ─── Zoho Books (invoicing) ─────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_ORG_STATE=
ZOHO_LOCATION_ID=
ZOHO_DC=
ZOHO_TAX_ID_GST18=
ZOHO_TAX_ID_IGST18=

# ─── Primary billing (our own GST tax-invoice engine) ───────────────────────
# Kill-switch, DEFAULT ON as of 2026-09-03 — same shape as
# RESELLER_FEATURE_ENABLED above. Our own GST engine is the PRIMARY invoice
# issuer, minting the real, legally-numbered TI/YYYY-YY/NNNNN tax invoice;
# Zoho Books is the automatic FALLBACK, used only when our engine throws.
#
# Leave blank to keep the GST engine live. Set to an explicit falsey value
# (false / 0 / no / off, case-insensitive) to disable it and send every call
# site straight back down the pre-existing Zoho path. Any other value,
# including an unrecognised one, means ENABLED — the fallback guarantees a
# customer is never left uninvoiced, so failing open is the safe direction.
# See lib/primary-billing-flag.ts.
#
# ROLLBACK: disable with the LITERAL string `false`, never by removing the
# var — deploy-cloud-run.sh treats an empty Cloud Run value as unset and
# falls back to this file, so a removal would be undone by the next deploy.
#
# Requires ZOHO_ORG_STATE to be set — the primary engine refuses to compute
# CGST/SGST vs IGST without a known place of supply and falls back to Zoho.
#
# Two invoice-number series coexist under one GSTIN once this is ON (ours and
# Zoho's on fallback); BOTH must be reported in GSTR-1. Flag to the CA before
# enabling in production.
#
# CAUTION: leave this BLANK in a real .env.local unless you are deliberately
# testing the primary engine locally. scripts/deploy-cloud-run.sh falls back
# to the shell value when Cloud Run has no value set, so a stray `true` here
# can push the flag ON in production on the next deploy. Production is
# toggled with `gcloud run services update --update-env-vars`, not from here.
PRIMARY_BILLING_ENABLED=

# ─── Renewal-payment dunning ────────────────────────────────────────────────
# Escalation stages (HOURS after an abandoned renewal checkout) at which a
# payment reminder is emailed. JSON array, ascending. The LAST value is the
# final reminder — after it's sent the order is marked abandoned and stops
# being chased. Leave blank for the default [24, 72, 168] (1 day / 3 days /
# 7 days). Consumed by app/api/cron/renewal-payment-dunning via
# config/automation.ts.
#
# The cron itself is NOT self-starting — it needs a Cloud Scheduler job:
#   bash scripts/setup-cloud-scheduler-billing.sh
# See docs/renewal-payment-dunning.md.
RENEWAL_DUNNING_HOURS=

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=

# ─── WhatsApp ───────────────────────────────────────────────────────────────
# (SMS / MSG91 removed 2026-07-16 — the phone SMS-OTP feature was retired.)

# WhatsApp (Meta Cloud API) — SPLIT-SOURCE config (operator decision 2026-07-03).
#
#   THE SECRET lives here / in Secret Manager ONLY — never in the DB or admin
#   panel. A developer sets + rotates it:
WHATSAPP_API_TOKEN=            # Meta permanent access token. SECRET. Secret Manager in prod.
WHATSAPP_APP_SECRET=           # Meta app secret. SECRET. Used to HMAC-verify inbound webhook POSTs.
WHATSAPP_WEBHOOK_VERIFY_TOKEN= # A string YOU choose; enter the same value in Meta's webhook config. Gates the GET handshake.
#
#   EVERYTHING BELOW is admin-panel-managed in production (Admin → Settings →
#   WhatsApp). The env vars here are only a LOCAL-DEV / bootstrap fallback —
#   once the same key is set in the admin panel, the DB value wins. Safe to
#   leave blank in prod once configured via the panel.
WHATSAPP_ENABLED=             # master on/off ("true"/"1"). Default OFF. Admin toggles in panel.
WHATSAPP_PHONE_NUMBER_ID=     # Meta phone-number ID (an identifier, not a secret)
WHATSAPP_TEMPLATE_PAYMENT=    # approved template name (default: payment_confirmed)
WHATSAPP_TEMPLATE_REMINDER=   # approved template name (default: service_renewal_reminder)
WHATSAPP_TEMPLATE_SUSPENDED=  # approved template name (default: service_suspended)
WHATSAPP_TEMPLATE_WELCOME=    # approved template name (default: hosting_provisioned)
# Note: whatsapp_business_number (display-only) is admin-panel-only — no env var.

# ─── Sub-reseller feature ───────────────────────────────────────────────────
# Kill-switch, DEFAULT ON. Leave blank/unset to keep the reseller feature live.
# Set to "false"/"0"/"no"/"off" to disable the admin Resellers panel + API
# without a redeploy (env-only, no admin DB toggle).
RESELLER_FEATURE_ENABLED=

# ─── GCP (Cloud Tasks for async work) ───────────────────────────────────────
GCP_PROJECT_ID=
GCP_QUEUE_LOCATION=
GCP_QUEUE_NAME=
GCP_ZOHO_QUEUE_NAME=

# ─── Cron / internal auth ───────────────────────────────────────────────────
CRON_SECRET=

# ─── AI / chat ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Test-only ──────────────────────────────────────────────────────────────
# Time-travel switches for the daily-scheduler / expiry tests. Leave unset
# in production.
ENABLE_TIME_SIMULATION=
SIMULATED_TIME=
