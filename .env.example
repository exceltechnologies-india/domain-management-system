# Environment variables consumed by the app. Copy to `.env.local` and fill
# in real values. Production deploys read from Secret Manager via Cloud Run
# — this file is for local dev + onboarding only.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
SUPPORT_EMAIL=
ADMIN_EMAIL=
ALLOWED_ORIGINS=

# ─── Database / cache ───────────────────────────────────────────────────────
MONGODB_URI=
REDIS_HOST=
REDIS_PORT=
FIELD_ENCRYPTION_KEY=

# ─── Auth (NextAuth + session) ──────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Razorpay (payments) ────────────────────────────────────────────────────
# Active Razorpay keys (what the app uses right now).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Both key sets for `scripts/switch-razorpay-mode.sh <test|live>` (one-command
# mode flip: swaps the active keys above + Secret Manager + full redeploy).
# Populate both once; copy your current live keys into the RAZORPAY_LIVE_* slots.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ─── ResellerClub (domain registrar) ────────────────────────────────────────
RESELLERCLUB_API_URL=
RESELLERCLUB_ID=
RESELLERCLUB_RESELLER_ID=
RESELLERCLUB_SECRET=
RESELLERCLUB_BALANCE_THRESHOLD=

# ─── DirectAdmin (hosting backend) ──────────────────────────────────────────
# DIRECTADMIN_IP: the public IP the DA panel uses for outbound webhook/origin
# checks. Cloud Run egress IP must be in DA's allow list (CSF + BFM + admin
# login key) — see memory/project_da_whitelist_layers.md.
# DA_DEFAULT_PACKAGE: fallback DA package name if the cart item didn't carry
# one (used by lib/services/payment/provisioner-hosting.ts).
DIRECTADMIN_URL=
DIRECTADMIN_ADMIN_USER=
DIRECTADMIN_API_KEY=
DIRECTADMIN_IP=
DA_DEFAULT_PACKAGE=

# ─── Billing (our own GST tax-invoice engine) ───────────────────────────────
# The GST engine is the ONLY invoice issuer. It always issues the real,
# legally-numbered TI/YYYY-YY/NNNNN tax invoice and has no on/off switch.
# Zoho Books was removed on 24 Sep 2026 by owner decision — there is no
# fallback engine, so a failure leaves the order flagged (invoiceFailedAt)
# for the retry paths and admin integration-health rather than issuing a
# second-series invoice.
#
# COMPANY_STATE: the state our GSTIN is registered in (Delhi for
# 07ABDCA0298H1ZP). Required — without it the engine cannot choose CGST+SGST
# vs IGST and refuses to invoice. Formerly ZOHO_ORG_STATE.
COMPANY_STATE=

RESELLER_FEATURE_ENABLED=

# ─── GCP (Cloud Tasks for async work) ───────────────────────────────────────
GCP_PROJECT_ID=
GCP_QUEUE_LOCATION=
GCP_QUEUE_NAME=
# Optional: a separate Cloud Tasks queue for renewal invoicing. Falls back to
# GCP_QUEUE_NAME when blank.
GCP_INVOICE_QUEUE_NAME=

# ─── Cron / internal auth ───────────────────────────────────────────────────
CRON_SECRET=

# ─── Engine API (inbound from ResellerOS) ───────────────────────────────────
# One key per blast radius — see lib/integrations/engine-auth.ts. A leak should
# cost exactly one capability, so do NOT reuse a stronger key to satisfy a
# weaker check. All three fail CLOSED: unset means every request is refused,
# which is the opposite of the feature flags elsewhere in this file.
#
# Reads only (GET /api/integrations/engine/*). Cannot change anything, cannot
# spend. This is the key ResellerOS holds in the most places.
ENGINE_READ_API_KEY=
# Creates a login account here. RESERVED — nothing reads this yet; there is
# no app/api/integrations/billing route. Setting it grants nothing.
BILLING_PROVISION_API_KEY=
# Triggers real infrastructure actions — register, renew, suspend, delete.
# Highest blast radius in the integration; treat it like a production password.
# Shared with ResellerOS as DMS_SSO_SECRET. Signs the 60-second,
# single-use hand-off that logs a ResellerOS user in here. Separate from
# NEXTAUTH_SECRET/JWT_SECRET because it is shared with another app and is
# therefore the likeliest of the three to leak. Unset = SSO refused.
ENGINE_SSO_SECRET=
BILLING_COMMAND_API_KEY=

# ResellerOS's public origin, e.g. https://app.example.com — include the
# scheme; a bare host is refused rather than turned into a broken link.
#
# Setting it makes ResellerOS the FRONT DOOR: DMS stops serving its own
# marketing homepage (`/` redirects there) and every brand/home link points
# at it, so DMS becomes the hosting/domain panel behind ResellerOS. Leaving
# it unset keeps DMS standalone with its own homepage — nothing is deleted.
#
# NEXT_PUBLIC_ means this is inlined by `next build`, NOT read at runtime: it
# has to be a build arg (see Dockerfile / docker-compose.yml) and changing it
# needs a rebuild. Setting it only on a running container does nothing.
NEXT_PUBLIC_RESELLEROS_URL=

# ─── ResellerOS server-to-server (outbound from DMS) ────────────────────────
# Owner decision 30 (25 Sep 2026): ResellerOS creates every Razorpay order,
# including purchases made in this panel. The ?buy=hosting / ?buy=domain
# dialogs call POST {RESELLEROS_SERVER_URL}/api/dms/panel-order.
#
# RUNTIME variables, read per request by server code — deliberately NOT
# NEXT_PUBLIC_RESELLEROS_URL, which is baked in at build time and is the PUBLIC
# origin (a container may need an internal address). Include the scheme.
# Unset = every in-panel purchase is REFUSED with a clear message. There is no
# DMS fallback order.
RESELLEROS_SERVER_URL=
# Same value as DMS_PANEL_API_KEY on ResellerOS. At least 16 characters.
DMS_PANEL_API_KEY=

# Shows the demo-accounts panel on /login. Local development only — the
# deploy script never passes it. Also a build arg, for the same reason.

# ─── AI / chat ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Test-only ──────────────────────────────────────────────────────────────
# Time-travel switches for the daily-scheduler / expiry tests. Leave unset
# in production.
ENABLE_TIME_SIMULATION=
SIMULATED_TIME=
