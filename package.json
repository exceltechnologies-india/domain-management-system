    "@types/bluebird": "^3.5.42",
    "@types/caseless": "^0.12.5",
    "@types/json5": "^0.0.30",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pako": "^2.0.4",
    "@types/prop-types": "^15.7.15",
    "@types/raf": "^3.4.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
