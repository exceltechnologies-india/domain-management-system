    "eslint-config-next": "^15.5.15",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.1.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": ">=8.5.13",
    "uuid": ">=14.0.0"
  }
}
