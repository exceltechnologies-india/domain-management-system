{
  "name": "domain-management-system",
  "version": "3.3.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config=vitest.integration.config.ts",
    "test:integration": "node tests/run-tests.js all",
    "test:api": "node tests/run-tests.js api",
    "test:payment": "node tests/run-tests.js payment",
    "test:pricing": "node tests/run-tests.js pricing",
    "test:admin": "node tests/run-tests.js admin",
    "test:lifecycle": "node tests/run-tests.js lifecycle",
    "health": "node scripts/health-check.js",
    "health:json": "node scripts/health-check.js --json",
    "check-tlds": "node scripts/check-tld-health.js",
    "setup": "node scripts/setup.js",
    "init-db": "node scripts/init-db.js",
    "migrate": "npx tsx scripts/db/migrate.ts",
    "migrate:status": "npx tsx scripts/db/migrate.ts --status",
    "migrate:dry": "npx tsx scripts/db/migrate.ts --dry-run",
    "recreate-admin": "node scripts/recreate-admin.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:summary": "npm audit --summary",
    "deps:outdated": "npm outdated",
    "deps:check": "npm audit && npm outdated",
    "deps:update": "npm update"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@google-cloud/tasks": "^6.2.1",
