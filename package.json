    "next": "^15.5.15",
    "next-auth": "^4.24.13",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "puppeteer": "^24.28.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "2.4.1",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.4",
    "styled-jsx": "^5.1.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "3.3.6",
    "typescript": "^6.0.3",
