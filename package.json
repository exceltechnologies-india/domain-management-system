    "@types/qrcode": "^1.5.6",
    "autoprefixer": "10.4.16",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "dns2": "^2.1.0",
    "dompurify": "^3.3.2",
    "dotenv": "^16.3.1",
